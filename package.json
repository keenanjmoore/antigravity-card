  ],
  "author": "Keenan",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "4.1.11"
  }
}
