{
  "name": "antigravity-no-icon-card",
  "version": "1.0.0",
  "description": "Antigravity No-Icon Card (Default) for Home Assistant — high-performance, full-width text and multi-domain slider controls",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check": "tsc --noEmit",
